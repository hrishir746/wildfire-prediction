#!/usr/bin/env python
"""
Lean fine-tune on pseudo-labels (CPU-optimized).
Uses small batch size, reduced dataset, pre-computed wind to avoid network timeouts.
"""
import sys
from pathlib import Path
ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT))

import numpy as np
import torch
import torch.nn as nn
from torch.utils.data import DataLoader, TensorDataset

from src.data.real_data import build_real_input_stack
from src.model import build_unet

# Parameters - CPU-friendly
bbox = (-121.3, 38.3, -120.8, 38.8)
size = (32, 32)  # Even smaller for CPU speed
n_samples = 5  # Minimal dataset for quick CPU training
batch_size = 1  # Batch of 1 for CPU
epochs = 1  # Just 1 epoch to test and save checkpoint

device = torch.device('cpu')
print('Device:', device)
print(f'Building pseudo-dataset: n={n_samples}, size={size}, batch={batch_size}')

# Fixed wind (no network call)
wind_speed = 5.0
wind_direction = 270.0

from src.simulation.rothermel_simulator import SimulationParams, FireSpreadSimulator

def compute_baseline_label(stack):
    rows, cols = size
    sim_params = SimulationParams(grid_rows=rows, grid_cols=cols, cell_size_m=30.0)
    sim = FireSpreadSimulator(sim_params)
    slope = stack[0] * 45.0
    fuel = stack[3]
    initial_fire = stack[7]
    fire_state = (initial_fire > 0.5).astype(np.int32)
    for _ in range(10):
        if not np.any(fire_state==1):
            break
        fire_state = sim.step(fire_state, slope, np.zeros_like(slope), wind_speed, wind_direction, fuel)
    return (fire_state > 0).astype(np.float32)

# Build dataset
stacks = []
labels = []
print('Generating pseudo-data (this may take a minute)...')
for i in range(n_samples):
    init = np.zeros(size, dtype=np.float32)
    cx = np.random.randint(size[1]//4, 3*size[1]//4)
    cy = np.random.randint(size[0]//4, 3*size[0]//4)
    rr = np.random.randint(1, 3)
    for dy in range(-rr, rr+1):
        for dx in range(-rr, rr+1):
            x = np.clip(cx+dx, 0, size[1]-1)
            y = np.clip(cy+dy, 0, size[0]-1)
            init[y, x] = 1.0
    
    try:
        # Use 3DEP without NWS wind fetch (no timeout)
        stack = build_real_input_stack(
            bbox[0], bbox[1], bbox[2], bbox[3],
            size,
            initial_fire=init,
            dem_source='3dep',
            wind_speed=wind_speed,
            wind_direction_deg=wind_direction,
            fetch_wind_from_nws=False
        )
    except Exception as e:
        print(f'  Sample {i} failed ({e}), skipping')
        continue
    
    label = compute_baseline_label(stack)
    stacks.append(stack)
    labels.append(label)
    print(f'  Sample {i+1}/{n_samples} done')

if len(stacks) == 0:
    print('ERROR: No samples generated')
    sys.exit(1)

X = np.stack(stacks).astype(np.float32)
Y = np.stack(labels)[:, None, :, :].astype(np.float32)
print(f'Dataset: X={X.shape}, Y={Y.shape}')

# Load and fine-tune model
ckpt_path = ROOT / 'outputs' / 'checkpoints' / 'unet_final.pt'
if not ckpt_path.exists():
    print(f'ERROR: Checkpoint {ckpt_path} not found')
    sys.exit(1)

ckpt = torch.load(ckpt_path, map_location=device)
model = build_unet(in_channels=8, out_channels=1, dropout_rate=0.2).to(device)
model.load_state_dict(ckpt['model_state_dict'])

tensor_x = torch.from_numpy(X)
tensor_y = torch.from_numpy(Y)
dataset = TensorDataset(tensor_x, tensor_y)
loader = DataLoader(dataset, batch_size=batch_size, shuffle=True)

optimizer = torch.optim.Adam(model.parameters(), lr=1e-5, weight_decay=1e-6)
criterion = nn.BCEWithLogitsLoss()

print(f'\nFine-tuning for {epochs} epochs...')
for epoch in range(epochs):
    model.train()
    total_loss = 0.0
    for xb, yb in loader:
        xb = xb.to(device)
        yb = yb.to(device)
        optimizer.zero_grad()
        logits = model(xb)
        loss = criterion(logits, yb)
        loss.backward()
        optimizer.step()
        total_loss += loss.item()
    avg_loss = total_loss / len(loader)
    print(f'Epoch {epoch+1}/{epochs}  loss={avg_loss:.4f}')

out_ckpt = ROOT / 'outputs' / 'checkpoints' / 'unet_finetune_camp2018.pt'
torch.save({'epoch': epochs, 'model_state_dict': model.state_dict()}, out_ckpt)
print(f'\n✓ Saved fine-tuned checkpoint to {out_ckpt}')

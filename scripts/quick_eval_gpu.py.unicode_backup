#!/usr/bin/env python
"""
Quick GPU evaluation script - test inference on existing checkpoint with GPU if available.
Supports 512x512 patches for large-scale wildfire mapping.

UTF-8 encoding configured for Windows compatibility.
"""
import sys
import os
from pathlib import Path

# UTF-8 encoding fix for Windows
if hasattr(sys.stdout, 'reconfigure'):
    sys.stdout.reconfigure(encoding='utf-8')
    sys.stderr.reconfigure(encoding='utf-8')
os.environ['PYTHONIOENCODING'] = 'utf-8'

ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT))

import numpy as np
import torch
from PIL import Image
import matplotlib.pyplot as plt

from src.model import build_unet

# Try to detect GPU
device = 'cuda' if torch.cuda.is_available() else 'cpu'
print(f"Using device: {device}")

# Load checkpoint
checkpoint_path = ROOT / 'outputs' / 'checkpoints' / 'unet_finetune_camp2018.pt'
print(f"Loading checkpoint: {checkpoint_path}")

model = build_unet(in_channels=8, out_channels=1)
model.load_state_dict(torch.load(checkpoint_path, map_location=device))
model = model.to(device)
model.eval()

print("Model loaded successfully!")

# Create dummy input (8 channels, 128x128)
dummy_input = torch.randn(1, 8, 128, 128).to(device)

print(f"Input shape: {dummy_input.shape}")
print(f"Input device: {dummy_input.device}")

# Inference
with torch.no_grad():
    output = model(dummy_input)
    
print(f"Output shape: {output.shape}")
print(f"Output device: {output.device}")
print(f"Output range: [{output.min():.4f}, {output.max():.4f}]")

print("\n✓ GPU evaluation complete!")
